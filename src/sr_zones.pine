//@version=6
indicator("Dynamic S/R Zones", overlay = true, max_boxes_count = 500)

// -----------------------------------------------------------------------------
// Inputs
// -----------------------------------------------------------------------------
groupPivots = "Pivot Detection"
leftBars  = input.int(10, "Left bars", minval = 1, group = groupPivots)
rightBars = input.int(5, "Right / confirmation bars", minval = 1, group = groupPivots)

groupVolume = "Volume Birth Gate"
volumeLength     = input.int(20, "Volume SMA length", minval = 1, group = groupVolume)
volumeMultiplier = input.float(1.5, "Volume multiplier", minval = 0.1, step = 0.1, group = groupVolume)

groupZones = "Initial Zone Geometry"
atrLength      = input.int(200, "ATR length", minval = 1, group = groupZones)
zoneMultiplier = input.float(0.4, "ATR zone multiplier", minval = 0.01, step = 0.01, group = groupZones)

groupLifecycle = "Zone Lifecycle"
maxBreaks        = input.int(3, "Freeze after breaks", minval = 1, group = groupLifecycle)
breakToleranceATR = input.float(0.10, "Break tolerance (ATR)", minval = 0.0, step = 0.01, group = groupLifecycle)
staleBars        = input.int(100, "Stale after bars without interaction", minval = 1, group = groupLifecycle)
staleDistanceATR = input.float(5.0, "Minimum distance for staleness (ATR)", minval = 0.1, step = 0.1, group = groupLifecycle)

groupDisplay = "Display"
showZoneInfo = input.bool(true, "Show zone info", group = groupDisplay)

// Prototype defaults above are intentionally adjustable. They will be tuned
// visually after we inspect the lifecycle on real charts.

// -----------------------------------------------------------------------------
// Visuals
// -----------------------------------------------------------------------------
supportBg     = color.new(color.teal, 85)
supportBorder = color.new(color.teal, 45)
resistBg      = color.new(color.red, 85)
resistBorder  = color.new(color.red, 45)
staleBg       = color.new(color.gray, 90)
staleBorder   = color.new(color.gray, 65)
zoneTextColor = color.black

// -----------------------------------------------------------------------------
// Zone model
// -----------------------------------------------------------------------------
type SRZone
    float lower
    float upper
    bool isSupport
    bool active
    int createdBar
    int lastInteractionBar
    int touchCount
    int reactionScore
    int breakCount
    float birthVolumeRatio
    box boxId

var zones = array.new<SRZone>()

// -----------------------------------------------------------------------------
// Pivot detection
// -----------------------------------------------------------------------------
pivotHigh = ta.pivothigh(high, leftBars, rightBars)
pivotLow  = ta.pivotlow(low, leftBars, rightBars)

// A pivot is discovered `rightBars` bars after it occurred. All birth evidence
// below is deliberately read from the historical pivot bar, not from the
// confirmation bar.
pivotVolume   = volume[rightBars]
priorVolumeMA = ta.sma(volume[1], volumeLength)[rightBars]
pivotATR      = ta.atr(atrLength)[rightBars]
pivotBar      = bar_index - rightBars

volumeQualified = not na(pivotVolume) and not na(priorVolumeMA) and pivotVolume > priorVolumeMA * volumeMultiplier
atrReady        = not na(pivotATR)
birthVolumeRatio = not na(priorVolumeMA) and priorVolumeMA > 0 ? pivotVolume / priorVolumeMA : na

// -----------------------------------------------------------------------------
// Zone helpers
// -----------------------------------------------------------------------------
zoneInfo(SRZone zone) =>
    if not showZoneInfo
        ""
    else
        string state = zone.active ? (zone.isSupport ? "S" : "R") : "FROZEN"
        string volumeText = na(zone.birthVolumeRatio) ? "n/a" : str.tostring(zone.birthVolumeRatio, "#.##") + "x"
        state + " | B:" + str.tostring(zone.breakCount) + " | V:" + volumeText + " | ATR:" + str.tostring(zoneMultiplier, "#.##")

updateZoneInfo(SRZone zone) =>
    box.set_text(zone.boxId, zoneInfo(zone))
    box.set_text_color(zone.boxId, zoneTextColor)
    box.set_text_size(zone.boxId, size.normal)
    box.set_text_halign(zone.boxId, zone.active ? text.align_left : text.align_right)
    box.set_text_valign(zone.boxId, text.align_top)

freezeZone(SRZone zone) =>
    zone.active := false
    box.set_extend(zone.boxId, extend.none)
    box.set_right(zone.boxId, bar_index)
    box.set_bgcolor(zone.boxId, staleBg)
    box.set_border_color(zone.boxId, staleBorder)
    updateZoneInfo(zone)
    zone

// -----------------------------------------------------------------------------
// Zone creation
// -----------------------------------------------------------------------------
createSupportZone(float pivotPrice) =>
    float lower = pivotPrice
    float upper = pivotPrice + pivotATR * zoneMultiplier
    box zoneBox = box.new(
         left = pivotBar,
         top = upper,
         right = bar_index,
         bottom = lower,
         xloc = xloc.bar_index,
         extend = extend.right,
         bgcolor = supportBg,
         border_color = supportBorder)

    SRZone zone = SRZone.new(
         lower,
         upper,
         true,
         true,
         bar_index,
         bar_index,
         0,
         0,
         0,
         birthVolumeRatio,
         zoneBox)

    updateZoneInfo(zone)
    array.push(zones, zone)

createResistanceZone(float pivotPrice) =>
    float upper = pivotPrice
    float lower = pivotPrice - pivotATR * zoneMultiplier
    box zoneBox = box.new(
         left = pivotBar,
         top = upper,
         right = bar_index,
         bottom = lower,
         xloc = xloc.bar_index,
         extend = extend.right,
         bgcolor = resistBg,
         border_color = resistBorder)

    SRZone zone = SRZone.new(
         lower,
         upper,
         false,
         true,
         bar_index,
         bar_index,
         0,
         0,
         0,
         birthVolumeRatio,
         zoneBox)

    updateZoneInfo(zone)
    array.push(zones, zone)

if volumeQualified and atrReady
    if not na(pivotLow)
        createSupportZone(pivotLow)

    if not na(pivotHigh)
        createResistanceZone(pivotHigh)

// -----------------------------------------------------------------------------
// Zone lifecycle
// -----------------------------------------------------------------------------
currentATR = ta.atr(atrLength)

if array.size(zones) > 0
    for i = 0 to array.size(zones) - 1
        SRZone zone = array.get(zones, i)

        if zone.active
            float breakTolerance = currentATR * breakToleranceATR
            bool broken = not na(currentATR) and (zone.isSupport ? close < zone.lower - breakTolerance : close > zone.upper + breakTolerance)

            if broken
                // A break requires a close beyond the outer boundary plus the
                // current-volatility tolerance. Wicks and marginal close-throughs
                // do not flip a zone.
                zone.breakCount += 1
                zone.lastInteractionBar := bar_index
                zone.reactionScore -= 1

                if zone.breakCount >= maxBreaks
                    // Repeated role reversals indicate that the area is no
                    // longer behaving as useful support/resistance. Preserve
                    // it historically, but retire it from active logic.
                    zone := freezeZone(zone)
                else
                    zone.isSupport := not zone.isSupport

                    if zone.isSupport
                        box.set_bgcolor(zone.boxId, supportBg)
                        box.set_border_color(zone.boxId, supportBorder)
                    else
                        box.set_bgcolor(zone.boxId, resistBg)
                        box.set_border_color(zone.boxId, resistBorder)

                    updateZoneInfo(zone)
            else
                // Any overlap with the zone counts as interaction for lifecycle
                // purposes. Several consecutive candles inside the same zone
                // keep refreshing the same interaction window.
                bool interacting = high >= zone.lower and low <= zone.upper
                if interacting
                    zone.lastInteractionBar := bar_index

            if zone.active
                float distanceFromZone = close > zone.upper ? close - zone.upper : close < zone.lower ? zone.lower - close : 0.0
                bool oldEnough = bar_index - zone.lastInteractionBar > staleBars
                bool farEnough = not na(currentATR) and distanceFromZone > currentATR * staleDistanceATR

                if oldEnough and farEnough
                    zone := freezeZone(zone)

            array.set(zones, i, zone)

// Hard resource guard. Frozen zones remain on the chart, so a finite cap is
// still necessary to respect TradingView's box-object limit.
maxStoredZones = 450
if array.size(zones) > maxStoredZones
    SRZone oldest = array.shift(zones)
    box.delete(oldest.boxId)
